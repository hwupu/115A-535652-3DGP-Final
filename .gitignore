# ---- Unity generated ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment to ignore Addressables / StreamingAssets build output
# /[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Autogenerated VS/MD/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds / packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.dmg
*.zip
*.7z

# Crashlytics / Burst / Bee
crashlytics-build.properties
/[Aa]ssets/[Pp]lugins/Editor/JetBrains*
*.log
/[Aa]ssets/Burst*
BurstDebugInformation_DoNotShip/
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
.utmp/

# Code coverage / test results
/[Cc]ode[Cc]overage/
TestResults/
InitTestScene*.unity*

# ---- IDEs / editors ----
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.fleet/
.history/
*.swp
*~
# Blender sources next to our models (Unity ignores ~ folders; see Assets/_Project/Art/README.md)
!Source~
!BlenderScripts~

# ---- OS specific ----
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
.directory
.nfs*

# ---- AI agent local state ----
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# ---- Unity Asset Store packages (free AND paid): NEVER commit (license) ----
# Import them locally into Assets/AssetStore/ (Package Manager > My Assets) and list them in docs/assets.md.
# How to install them: docs/asset-store-packs.md.
/[Aa]ssets/AssetStore/
/[Aa]ssets/AssetStore.meta
# The packs we use, in case they are still where Unity imports them (before moving them into Assets/AssetStore/).
/[Aa]ssets/maanetorn/
/[Aa]ssets/maanetorn.meta
/[Aa]ssets/Free Stylized Hand-Painted Skybox/
/[Aa]ssets/Free Stylized Hand-Painted Skybox.meta
/[Aa]ssets/Handpainted_Grass_and_Ground_Textures/
/[Aa]ssets/Handpainted_Grass_and_Ground_Textures.meta
/[Aa]ssets/Pandazole_Ultimate_Pack/
/[Aa]ssets/Pandazole_Ultimate_Pack.meta
